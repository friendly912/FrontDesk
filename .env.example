TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SHOPS_DIR=./shops
VALIDATE_TWILIO_SIGNATURE=true

# "csv" (default) needs no Google account — bookings are appended to
# LOCAL_DATA_DIR/<shop_id>/bookings.csv. Switch to "google_sheets" once you
# have a Google Cloud service account and set GOOGLE_SERVICE_ACCOUNT_FILE.
BOOKINGS_BACKEND=csv
LOCAL_DATA_DIR=./data
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# Set when running behind ngrok/a proxy so signature validation checks the
# public URL Twilio actually posted to, not the internal one FastAPI sees.
PUBLIC_BASE_URL=

# Protects GET /debug/bookings/{shop_id} (reads back the raw CSV, including
# customer phone numbers and messages). Leave blank for local dev only —
# set a random value before deploying anywhere public.
DEBUG_TOKEN=
